; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Trilink PvP"
config/description="A two-player LAN-based 2.5D arena fighting game built around RGB color matching, phasing, hazards, and shifting gravity."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SettingsManager="*res://autoload/settings_manager.gd"
InputManager="*res://autoload/input_manager.gd"
DeviceManager="*res://autoload/device_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/movie_file="G:/Apps/Vault/Second Brain/Weasert/02 - Projects/gamedev/tri-link/tests/gm.avi"

[filesystem]

import/blender/enabled=false

